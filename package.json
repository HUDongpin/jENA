{
  "name": "jena-js",
  "version": "0.1.1",
  "description": "Standalone TypeScript/JavaScript library for Epistemic Network Analysis, ported from rENA for browser and Node runtimes.",
  "type": "module",
  "license": "GPL-3.0-only",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./plot": {
      "types": "./dist/plot/index.d.ts",
      "import": "./dist/plot/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./browser/worker": {
      "types": "./dist/browser/worker.d.ts",
      "import": "./dist/browser/worker.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tests",
    "scripts",
    "fixtures",
    "tsconfig.json",
    "vitest.config.ts",
    "CHANGELOG.md",
    "PROVENANCE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/core/index.ts src/plot/index.ts src/browser/index.ts src/browser/worker.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "goldens:r": "Rscript scripts/regen-goldens-rstudio.R .",
    "goldens:diff": "node scripts/compare-goldens.mjs",
    "goldens:compare": "vitest run tests/r-goldens.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
