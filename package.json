{
  "name": "jena-js",
  "version": "0.3.0",
  "description": "Standalone TypeScript/JavaScript library for Epistemic Network Analysis, ported from rENA for browser and Node runtimes.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Dongpin Hu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HUDongpin/jENA.git"
  },
  "homepage": "https://github.com/HUDongpin/jENA#readme",
  "bugs": {
    "url": "https://github.com/HUDongpin/jENA/issues"
  },
  "keywords": [
    "ena",
    "epistemic-network-analysis",
    "rENA",
    "learning-analytics",
    "quantitative-ethnography",
    "network-analysis"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./plot": {
      "types": "./dist/plot/index.d.ts",
      "import": "./dist/plot/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./browser/worker": {
      "types": "./dist/browser/worker.d.ts",
      "import": "./dist/browser/worker.js"
    }
  },
  "files": [
    "dist",
    "PROVENANCE.md",
    "NUMERICS.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/core/index.ts src/plot/index.ts src/browser/index.ts src/browser/worker.ts --format esm --dts --sourcemap --clean",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run pack:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pack:check": "node scripts/pack-check.mjs",
    "goldens:r": "Rscript scripts/regen-goldens-rstudio.R .",
    "goldens:stats": "Rscript scripts/generate-stats-goldens.R .",
    "goldens:rotations": "Rscript scripts/generate-rotation-goldens.R .",
    "goldens:diff": "node scripts/compare-goldens.mjs",
    "goldens:compare": "vitest run tests/r-goldens.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
